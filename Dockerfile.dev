FROM node:22-bookworm-slim

# macOS desktop builds must run on a macOS host — this container is for
# Linux CI / dev only (no macOS-specific APIs like NSVisualEffectView).

# Install Rust toolchain
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    libgtk-3-dev \
    libglib2.0-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install pnpm (pinned version — do not upgrade to 11.x)
RUN npm install -g pnpm@10.11.0

WORKDIR /workspace

CMD ["/bin/bash"]
