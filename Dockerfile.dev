# Dockerfile.dev — GAMBIT development container
#
# macOS GUI builds (pnpm tauri dev) run on the host because stock Docker
# cannot render a macOS Cocoa window. This container is for:
#   - pnpm install / lint / typecheck
#   - cargo check
#   - Linux AppImage builds
#   - CI parity
#
# Usage: docker compose run --rm dev <command>
# Or via Makefile: make install / make ci / make shell

FROM node:22-bookworm-slim

# ---- System deps: Tauri Linux prerequisites ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    file \
    git \
    ca-certificates \
    pkg-config \
    libwebkit2gtk-4.1-dev \
    libssl-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# ---- Rust stable via rustup ----
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- tauri-cli v2 ----
RUN cargo install tauri-cli --version "^2" --locked

# ---- pnpm — pinned to 10.x (pnpm 11 breaks pnpm exec) ----
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

# ---- Working directory ----
WORKDIR /workspace

CMD ["bash"]
