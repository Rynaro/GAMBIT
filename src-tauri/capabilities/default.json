{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capabilities/schema.json",
  "identifier": "default",
  "description": "Default capability set for GAMBIT.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "shell:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.eidolons/**" },
        { "path": "$HOME/**/eidolons.yaml" },
        { "path": "$HOME/**/eidolons.lock" },
        { "path": "$HOME/**/eidolons.mcp.lock" },
        { "path": "$HOME/**/.eidolons/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/.eidolons/**" },
        { "path": "$HOME/**/.eidolons" },
        { "path": "$HOME/**/.eidolons/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.eidolons/**" },
        { "path": "$HOME/**/eidolons.yaml" },
        { "path": "$HOME/**/eidolons.lock" },
        { "path": "$HOME/**/eidolons.mcp.lock" },
        { "path": "$HOME/**/.eidolons/**" }
      ]
    }
  ]
}
