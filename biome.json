{
  "$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
  "files": {
    "ignore": [
      ".claude/**",
      ".codex/**",
      ".eidolons/**",
      ".atlas/**",
      ".spectra/**",
      ".junction/**",
      ".devcontainer/**",
      ".pnpm-store/**",
      "dist/**",
      "public/**",
      "src-tauri/**",
      "pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsoleLog": "warn",
        "noArrayIndexKey": "warn",
        "noControlCharactersInRegex": "warn",
        "noShorthandPropertyOverrides": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noUselessFragments": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "include": ["tests/**", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "performance": {
            "noDelete": "off"
          },
          "style": {
            "useNodejsImportProtocol": "off",
            "noNonNullAssertion": "off",
            "noUnusedTemplateLiteral": "off"
          }
        }
      }
    }
  ]
}
